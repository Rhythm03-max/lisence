# Supabase configuration
# Copy to .env.local and fill in the values from your Supabase project
# (Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public site URL, used to build QR / verification links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Outgoing mail (used to email applicants when a permit is approved).
# Leave SMTP_HOST empty to disable sending; approvals still succeed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=National Electronic Licensing System

